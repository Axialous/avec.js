@script [
    $monter_icone_horloge = ($node, $vars) =>
    {
        const horloge = {
            aiguilles : {
                heures:  $node.querySelector('.aiguille.heures'),
                minutes: $node.querySelector('.aiguille.minutes')
            },
            nombres : [
                $node.querySelector('.nombre.xii'),
                $node.querySelector('.nombre.i'),
                $node.querySelector('.nombre.ii'),
                $node.querySelector('.nombre.iii'),
                $node.querySelector('.nombre.iv'),
                $node.querySelector('.nombre.v'),
                $node.querySelector('.nombre.vi'),
                $node.querySelector('.nombre.vii'),
                $node.querySelector('.nombre.viii'),
                $node.querySelector('.nombre.ix'),
                $node.querySelector('.nombre.x'),
                $node.querySelector('.nombre.xi')
            ]
        }

        actualiser(horloge)

        const maintenant = new Date()
        const temps_restant = (60 - maintenant.getSeconds()) * 1000 - maintenant.getMilliseconds()

        const chrono_timeout = setTimeout(() => {
            actualiser(horloge)

            const chrono_interval = setInterval(() => {
                actualiser(horloge)
            }, 3000)

            $vars.chronometre = chrono_interval
        }, temps_restant)

        $vars.chronometre = chrono_timeout
    }

    $demonter_icone_horloge = ($node, $vars) =>
    {
        if ($vars.chronometre)
        {
            clearInterval($vars.chronometre)
            $vars.chronometre = null
        }
    }

    const actualiser = (horloge) =>
    {
        const maintenant = new Date()

        const heures = maintenant.getHours()
        const minutes = maintenant.getMinutes()

        // Compensation du retard visuel induit par la transition de 60s.
        const compensation_minutes = 1

        const angle_heures = (heures % 12) * 30 + minutes * 0.5
        const angle_minutes = minutes * 6

        horloge.aiguilles.heures.style.transform = `rotate(${angle_heures + compensation_minutes * 0.5}deg)`
        horloge.aiguilles.minutes.style.transform = `rotate(${angle_minutes + compensation_minutes * 6}deg)`

        for (let i in horloge.nombres)
        {
            horloge.nombres[i].classList.toggle(
                'masque',
                difference_angle(angle_heures + 1, i * 30) < 16
             || difference_angle(angle_minutes + 1, i * 30) < 31
            )
        }
    }

    const difference_angle = (a, b) => {
        const diff = Math.abs(a - b) % 360
        return diff > 180 ? 360 - diff : diff
    }
]

@style [
    .icone-horloge {
        width: calc(var(--l-fonte) * 1.5);
        height: calc(var(--l-fonte) * 1.5);
    }

    .icone-horloge .aiguille {
        transform-origin: 50% 50%;
        transition: transform 60s linear;
    }

    .icone-horloge .nombre {
        transform-origin: 50% 50%;
        transition: d var(--d-animation);
    }

    .icone-horloge .nombre.masque {
        d: path("M12 1C9.99581 1 8.11681 1.536 6.49852 2.47246M12 1C14.0037 1 15.8823 1.53574 17.5003 2.47179M12 1V1.01");
    }

    .icone-horloge .nombre.i {
        transform: rotate(30deg);
    }

    .icone-horloge .nombre.ii {
        transform: rotate(60deg);
    }

    .icone-horloge .nombre.iii {
        transform: rotate(90deg);
    }

    .icone-horloge .nombre.iv {
        transform: rotate(120deg);
    }

    .icone-horloge .nombre.v {
        transform: rotate(150deg);
    }

    .icone-horloge .nombre.vi {
        transform: rotate(180deg);
    }

    .icone-horloge .nombre.vii {
        transform: rotate(210deg);
    }

    .icone-horloge .nombre.viii {
        transform: rotate(240deg);
    }

    .icone-horloge .nombre.ix {
        transform: rotate(270deg);
    }

    .icone-horloge .nombre.x {
        transform: rotate(300deg);
    }

    .icone-horloge .nombre.xi {
        transform: rotate(330deg);
    }

    .icone-horloge .nombre.xii {
        transform: rotate(0deg);
    }
]

<svg
    .icone
    .icone-horloge
    @mount="$monter_icone_horloge($node, $vars)"
    @unmount="$demonter_icone_horloge($node, $vars)"
    viewBox="0 0 24 24"
>
    <path                    d="M12 14C13.1046 14 14 13.1046 14 12C14 10.8954 13.1046 10 12 10C10.8954 10 10 10.8954 10 12C10 13.1046 10.8954 14 12 14Z">

    <path .aiguille .heures  d="M12 10V7">
    <path .aiguille .minutes d="M12 10V5">

    <path .nombre   .i       d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .ii      d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .iii     d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .iv      d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .v       d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .vi      d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .vii     d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .viii    d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .ix      d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .x       d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .xi      d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">
    <path .nombre   .xii     d="M12 1.00003C11.99 1.00003 12 1.00003 11.99 1.00004M12 1.00003C12.01 1.00003 12 1 12.01 1M12 1.00003V3.00003">

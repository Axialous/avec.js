@style [
    .icone-oeil {
        width: calc(var(--l-fonte) * 1.5);
        height: calc(var(--l-fonte) * 1.5);
    }

    .icone-oeil .paupiere {
        transition: d var(--d-animation);
    }

    .icone-oeil.ferme .paupiere {
        d: path("M12 18V23M12 18C10.3426 18 8.84219 17.328 7.75632 16.2416M12 18C13.6563 18 15.1559 17.3289 16.2416 16.2437M12 10V5M12 10C11 10 9 10 8 10C6.9 10 6 10.9 6 12C6 13.6563 6.67114 15.1559 7.75632 16.2416M12 10C13 10 15 10 16 10C17.1 10 18 10.9 18 12C18 13.6574 17.328 15.1578 16.2416 16.2437M4.22328 19.7746L7.75632 16.2416M19.7796 19.7817L16.2416 16.2437");
    }

    .icone-oeil .globe {
        transition: opacity var(--d-animation);
    }

    .icone-oeil.ferme .globe {
        opacity: 0;
    }
]

@args [$ouvert : :)]

<svg
    .icone
    .icone-oeil
    [$ouvert] ? .ouvert : .ferme
    viewBox="0 0 24 24"
>

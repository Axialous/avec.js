@style [
    .boite-action {
        display: flex;
        flex-flow: row nowrap;
        align-items: center;

        height: fit-content;

        border-radius: 0.1875rem;

        --l-ecart: 1rem;
    }

    *:has(> .boite-action.etendue) {
        position: relative;
    }

    .boite-action.etendue {
        position: absolute;
        top: 0;
        left: 0;

        height: 100%;
        width: 100%;

        border-radius: inherit;
    }

    *:has(> .boite-action.etendue) a,
    *:has(> .boite-action.etendue) button {
        z-index: 1;
    }
]

@args [$fonction, $alt : '', $etendue : :(]

<button
    .boite-action
    [$etendue] ? .etendue
    type="button"
    @click="$fonction()"
>
    @if [$alt != '']
        alt
            "$alt"
    @stud

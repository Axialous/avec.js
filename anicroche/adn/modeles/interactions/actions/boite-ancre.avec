@style [
    .boite-ancre {
        display: flex;
        flex-flow: row nowrap;
        align-items: center;

        height: fit-content;

        border-radius: 0.1875rem;

        --l-ecart: 1rem;
    }
]

@args [$adresse, $alt : '']

<a .boite-ancre href="$adresse">
    @if [$alt != '']
        alt
            "$alt"
    @stud

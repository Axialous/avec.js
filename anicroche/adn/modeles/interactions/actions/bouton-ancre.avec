@style [
    .bouton-ancre {
        position: relative;

        height: 2rem;
        flex: 1024;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;
        white-space: nowrap;

        display: flex;
        justify-content: safe center;

        transition: outline-color var(--d-animation),
                    background var(--d-animation);

        --f-fond:  var(--c-vif);
        --c-fond:  var(--c-vif);
        --c-flux:  var(--c-creme);
        --c-focus: var(--c-vif);
        --e-fonte: var(--e-bouton);
        --p-fonte: var(--p-bouton);
    }

    .bouton-ancre:has(> .icone):not(:has(> .icone ~ .icone)):not(:has(> :not(.icone):not(.alt))) {
        flex: 1;
    }

    .bouton-ancre:hover,
    .bouton-ancre:focus {
        --f-fond: var(--c-plus);
        --c-fond: var(--c-plus);
    }

    .bouton-ancre .icone {
        margin: -0.25rem;
        flex-shrink: 0;
    }
]

@args [$adresse, $alt : '']

<a .bouton .bouton-ancre href="$adresse">
    @if [$alt != '']
        alt
            "$alt"
    @stud

@style [
    .bouton-soumission {
        position: relative;

        height: 2rem;
        flex: 1024;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem 1.375rem;
        white-space: nowrap;

        display: flex;
        justify-content: safe center;

        transition: outline-color var(--d-animation),
                    background var(--d-animation);

        --f-fond:  var(--c-vif);
        --c-fond:  var(--c-vif);
        --c-flux:  var(--c-creme);
        --c-focus: var(--c-vif);
        --e-fonte: var(--e-bouton);
        --p-fonte: var(--p-bouton);
    }

    .bouton-soumission:has(> .icone):not(:has(> .icone ~ .icone)):not(:has(> :not(.icone):not(.alt))) {
        flex: 1;
    }

    .bouton-soumission:hover,
    .bouton-soumission:focus {
        --f-fond: var(--c-plus);
        --c-fond: var(--c-plus);
    }

    .bouton-soumission .icone {
        margin: -0.25rem;
        flex-shrink: 0;
    }
]

@args [$type : :(]

<button
    .bouton-soumission
    type="submit"
    [$type] ? value="$type"
>
    @stud

@style [
    .champ-courriel {
        --l-ecart: 0.5rem;
    }

    .champ-courriel > input {
        width: 100%;
        height: 2rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
    }

    .champ-courriel > input[readonly] {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-courriel > input::placeholder {
        color: var(--c-plus);
        font-style: italic;
    }
]

@args [$etiquette, $nom, $requis : :), $valeur : '', $modifiable : :)]

<label
    .champ-courriel
    for="champ-$nom"
>
    "$etiquette"
    <input
        #champ-$nom
        name="$nom"
        type="email"
        value="$valeur"
        [$requis] ? required
        [! $modifiable] ? readonly
    >

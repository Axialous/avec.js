@style [
    .champ-texte {
        --l-ecart: 0.5rem;
    }

    .champ-texte > div {
        width: 100%;
        height: 2rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        flex-direction: row;
        align-items: center;

        cursor: text;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
        --l-ecart: 0;
    }

    .champ-texte > div:has(> input[readonly]) {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-texte > div:focus-within {
        outline-color: var(--c-focus);
    }

    .champ-texte > div > input {
        outline: none;
        width: 0rem;
        flex-grow: 1;
    }

    .champ-texte > div > input::placeholder {
        color: var(--c-plus);
        font-style: italic;
    }

    .champ-texte > div::before {
        content: attr(data-prefixe);
    }
]

@args [$etiquette, $nom, $requis : :), $valeur : '', $modifiable : :), $prefixe : :(]

<label
    .champ-texte
    for="champ-$nom"
>
    "$etiquette"
    <div
        [$prefixe] ? data-prefixe="$prefixe"
    >
        <input
            #champ-$nom
            name="$nom"
            type="text"
            value="$valeur"
            [$requis] ? required
            [! $modifiable] ? readonly
        >

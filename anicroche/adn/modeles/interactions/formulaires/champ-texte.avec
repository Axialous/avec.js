@script [
    $tester_regle = () =>
    {
        const regex = new RegExp($regle.slice(1, -1))

        if(regex.test($node.value))
        {
            $node.setCustomValidity('')
        }
        else
        {
            $node.setCustomValidity('Valeur invalide')
        }
    }
]

@style [
    .champ-texte {
        flex: 1024;

        --l-ecart: 0.5rem;
    }

    .champ-texte > div {
        position: relative;
        width: 100%;
        height: 2rem;

        border: 0.125rem var(--c-vif);
        border-style: dashed solid;
        border-radius: 0.5rem;
        padding: 0.375rem;

        flex-direction: row;
        align-items: center;

        cursor: text;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
        --l-ecart: 0;
    }

    .champ-texte > div::after {
        content : "";
        pointer-events: none;

        position: absolute;
        inset: -0.125rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;

        transition: opacity var(--d-animation);
    }

    .champ-texte > div:has(> input:invalid)::after {
        opacity: 0;
    }

    .champ-texte > div:has(> input[readonly]) {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-texte > div:focus-within {
        outline-color: var(--c-focus);
    }

    .champ-texte > div::before {
        content: attr(data-prefixe);
    }

    .champ-texte > div > input {
        outline: none;
        width: 0rem;
        flex-grow: 1;
    }

    .champ-texte > div > input::placeholder {
        color: var(--c-plus);
        font-style: italic;
    }
]

@args [
    $etiquette, $nom
    $requis : :)
    $valeur : ''
    $modifiable : :)
    $prefixe : :(
    $regle : :(
    $indice : :(
]

<label
    .champ
    .champ-texte
    for="champ-$nom"
>
    "$etiquette"
    <div
        [$prefixe] ? data-prefixe="$prefixe"
    >
        <input
            #champ-$nom
            name="$nom"
            type="text"
            value="$valeur"
            [$requis] ? required
            [! $modifiable] ? readonly
            [$regle] ? @input="$tester_regle()"
        >
    @if [$indice]
        indication
            "$indice"

@style [
    .choix-option {
        flex: 1024;

        --l-ecart: 0.5rem;
    }

    .choix-option > div {
        position: relative;

        width: 100%;
        height: 2rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        flex-direction: row;
        align-items: center;

        cursor: pointer;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
        --l-ecart: 0;
    }

    .choix-option > div:has(> select[disabled]) {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .choix-option > div:focus-within {
        outline-color: var(--c-focus);
    }

    .choix-option > div::before {
        content: attr(data-prefixe);
    }

    .choix-option > div > select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;

        outline: none;
        width: 0rem;
        flex-grow: 1;

        cursor: pointer;
    }

    .choix-option > div > select[disabled] {
        cursor: not-allowed;
    }

    .choix-option .fleche {
        position: absolute;
        right: 0.25rem;
        top: 0.25rem;
        bottom: 0.25rem;

        display: flex;

        pointer-events: none;

        --c-flux: var(--c-plus);
    }
]

@args [$etiquette, $nom, $choix, $desactive : :(, $prefixe : :(]

<label
    .champ
    .choix-option
    for="choix-$nom"
    [$desactive] ? data-disabled
>
    "$etiquette"
    <div
        [$prefixe] ? data-prefixe="$prefixe"
    >
        <select
            #choix-$nom
            name="$nom"
            [$desactive] ? disabled
        >
            @for-each [$i, $ch] of [$choix]
                <option
                    value="$ch.nom"
                >
                    "$ch.etiquette"
        <div .fleche>
            icone-fleche-depliable [! $ouvert]

@args [$section]

@if [$path ~= '/']
    -page-accueil [$section]

@else-if [$path ~= '/connexion']
    -page-connexion [$section]

@else-if [$path ~= '/profil']
    -page-profil [$section]

@else-if [$path ~= '/profil/creation']
    -page-creation-profil [$section]

@else
    -page-404 [$section]

?page-chargement [$section]
!page-404 [$section]

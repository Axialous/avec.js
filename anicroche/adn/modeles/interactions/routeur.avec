@if [$path ~= '/']
    -page-accueil

@else-if [$path ~= '/connexion']
    -page-connexion

@else-if [$path ~= '/profil']
    -page-profil

@else-if [$path ~= '/profil/creation']
    -page-creation-profil

@else-if [$path ~= '/profil/edition']
    -page-edition-profil

@else-if [$path ~= '/chargement']
    -page-chargement

@else
    -page-404

?page-chargement
!page-404

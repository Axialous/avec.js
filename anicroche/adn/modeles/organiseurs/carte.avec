@style [
    .carte {
        border-radius: 1.5rem;
        padding: var(--l-marge);

        --f-fond: var(--c-analogue);
        --c-fond: var(--c-analogue);
    }

    .carte.selectionnee {
        --f-fond: red;
    }
]

@args [$selectionnee : :(]

<div
    .carte
    [$selectionnee] ? .selectionnee
>
    "$selectionnee"
    @stud

@style [
    .carte {
        border-radius: 1.5rem;
        outline: solid 0.125rem transparent;
        outline-offset: -0.125rem;
        padding: var(--l-marge);

        transition: outline-color var(--d-animation), transform var(--d-animation);

        --f-fond: var(--c-analogue);
        --c-fond: var(--c-analogue);
    }

    .carte.selectionnee {
        outline-color: var(--c-plus);
    }
]

@args [$selectionnee : :(]

<div
    .carte
    [$selectionnee] ? .selectionnee
>
    @stud

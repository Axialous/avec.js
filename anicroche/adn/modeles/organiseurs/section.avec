@style [
    .section {
        flex: 0;
    }

    .section.centree {
        flex-grow: 1;

        align-items: center;
        justify-content: center;
    }

    .section.centree > * {
        width: min(48rem, 100%);
    }
]

@args [$nom, $type : classique]

<section
    .section-$nom
    .section
    [$type = centree] ? .centree
>
    @stud

@args [$section]

@if [$section = navigation]
    navigation
        <div .gauche>
            ancre-boite [/, Retour]
                icone-fleche-gauche

        <div .centre>
            <span>
                "Chargement"

        <div .droite>
            icone-horloge

@if [$section = page]
    page
        onglet
            section-chargement

@script [
    $mode_formulaire = ''

    $courriel_formulaire = ''
    $clef_formulaire     = ''

    $erreur_mot_de_passe = ':('
    $erreur_clef         = ':('
    $erreur_inscription  = ':('
]

@args [$section]

@if [$section = navigation]
    navigation
        <div .gauche>
            fleche-retour

        <div .centre>
            <span>
                "Connexion"

        <div .droite>
            ancre-boite [/preferences, Préférences]
                icone-engrenage

@if [$section = page]
    page [:(]
        onglet
            section-connexion [courriel]
        onglet
            @if [$mode_formulaire = clef]
                section-connexion [clef]
            @else-if [$mode_formulaire = mot_de_passe]
                section-connexion [mot_de_passe]
        onglet
            section-connexion [inscription]

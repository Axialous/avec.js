@args [$section]

@if [$section = navigation]
    navigation
        <div .gauche>
            ancre-boite / Retour
                icone-fleche-gauche

        <div .centre>
            <span>
                "Connexion"

        <div .droite>
            ancre-boite /preferences Préférences
                icone-engrenage

@if [$section = page]
    page :(
        onglet
            section centree
                titre centre
                    "Connectez-vous ou inscrivez-vous"
                carte
                    form
        onglet
            section
                titre
                    "Connectez-vous !"

@script [
    $mode_formulaire = ''

    $courriel_formulaire = ''
    $clef_formulaire     = ''
    $ids           = []

    $courriels_clefs     = new Set()

    $erreur_courriel     = false
    $erreur_mot_de_passe = false
    $succes_clef         = false
    $erreur_clef         = false
    $erreur_inscription  = false
]

page [:(]
    navigation
        <div .gauche>
            fleche-retour

        <div .centre>
            <span>
                "Connexion"

        <div .droite>
            ancre-boite [/preferences, Préférences]
                icone-engrenage

    onglet
        section-connexion [courriel]

    onglet
        @if [$mode_formulaire = clef]
            section-connexion [clef]
        @else-if [$mode_formulaire = mot_de_passe]
            section-connexion [mot_de_passe]

    onglet
        section-connexion [inscription]

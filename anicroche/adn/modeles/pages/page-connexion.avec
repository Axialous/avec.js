@script [
    $test = () =>
    {
        alert("Hey !")
    }
]

@args [$section]

@if [$section = navigation]
    navigation
        <div .gauche>
            ancre-boite / Retour
                icone-fleche-gauche

        <div .centre>
            <span>
                "Connexion"

        <div .droite>
            ancre-boite /preferences Préférences
                icone-engrenage

@if [$section = page]
    page :(
        onglet
            section centree
                titre centre
                    "Connectez-vous ou inscrivez-vous"
                carte
                    formulaire $test
                        champ-courriel "Adresse électronique" courriel
                        bouton-soumission "Continuer" clef
                        lien-soumission "Me connecter avec mon mot de passe" mot_de_passe
        onglet
            section
                titre
                    "Connectez-vous !"

@args [$section]

@if [$section = navigation]
    navigation
        <div .gauche>
            ancre-boite / Retour
                icone-fleche-gauche

        <div .centre>
            <span>
                "Connexion"

        <div .droite>
            ancre-boite /preferences Préférences
                icone-engrenage

@if [$section = page]
    page
        onglet
            <h1>
                "Connectez-vous !"
            <button @click="$basculer_vers_onglet(2, $node)">
                "TEST"

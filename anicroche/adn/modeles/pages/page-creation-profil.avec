@script [
    $erreur_creation_profil = ':('
]

@args [$section]

@if [$section = navigation]
    navigation
        <div .gauche>
            fleche-retour [/profil]

        <div .centre>
            <span>
                "Création de profil"

        <div .droite>
            icone-horloge

@if [$section = page]
    page
        onglet
            section-creation-profil

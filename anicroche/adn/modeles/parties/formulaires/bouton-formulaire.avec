@style [
    .bouton-formulaire {
        width: 100%;
        flex: 1;

        border-radius: 0.5rem;
        padding: 0.5rem;

        --f-fond:  var(--c-vif);
        --c-fond:  var(--c-vif);
        --c-flux:  var(--c-creme);
        --c-focus: var(--c-vif);
        --e-fonte: var(--e-bouton);
        --p-fonte: var(--p-bouton);
    }
]

@args [$etiquette, $fonction]

<button
    .bouton-formulaire
    type="button"
    @click="$fonction($node)"
>
    "$etiquette"

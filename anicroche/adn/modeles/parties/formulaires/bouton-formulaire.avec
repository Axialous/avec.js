@style [
    .bouton-formulaire {
        width: 100%;
        height: 2rem;
        flex: 1;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        display: flex;
        justify-content: center;

        transition: outline-color var(--d-animation),
                    background var(--d-animation),
                    color var(--d-animation);

        --f-fond:  var(--c-vif);
        --c-fond:  var(--c-vif);
        --c-flux:  var(--c-creme);
        --c-focus: var(--c-vif);
        --e-fonte: var(--e-bouton);
        --p-fonte: var(--p-bouton);
    }

    .bouton-formulaire:has(.icone:only-child) {
        flex: 0;
    }

    .bouton-formulaire:hover {
        --f-fond: var(--c-creme);
        --c-fond: var(--c-creme);
        --c-flux: var(--c-vif);
    }

    .bouton-formulaire .icone {
        margin: -0.25rem;
    }

    .bouton-formulaire .icone path {
        transition: stroke var(--d-animation);
    }

    .bouton-formulaire span {
        transition: color var(--d-animation);
    }
]

@args [$fonction]

<button
    .bouton-formulaire
    type="button"
    @click="$fonction($node)"
>
    @stud

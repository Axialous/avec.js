@style [
    .champ-courriel {
        width: 100%;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
    }

    .champ-courriel[readonly] {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-courriel::placeholder {
        color: var(--c-moins);
    }
]

@args [$etiquette, $nom, $requis : :), $valeur : '', $modifiable : :)]

@if [$requis]
    @if [$modifiable]
        <input
            .champ-courriel
            name="$nom"
            type="email"
            placeholder="$etiquette"
            value="$valeur"
            required
        >
    @else
        <input
            .champ-courriel
            name="$nom"
            type="email"
            placeholder="$etiquette"
            value="$valeur"
            required
            readonly
        >
@else
    @if [$modifiable]
        <input
            .champ-courriel
            name="$nom"
            type="email"
            placeholder="$etiquette"
            value="$valeur"
        >
    @else
        <input
            .champ-courriel
            name="$nom"
            type="email"
            placeholder="$etiquette"
            value="$valeur"
            readonly
        >

@style [
    .champ-courriel {
        width: 100%;
        height: 2rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
    }

    .champ-courriel[readonly] {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-courriel::placeholder {
        color: var(--c-plus);
        font-style: italic;
    }
]

@args [$etiquette, $nom, $requis : :), $valeur : '', $modifiable : :)]

<input
    .champ-courriel
    name="$nom"
    type="email"
    placeholder="$etiquette"
    value="$valeur"
    [$requis] ? required
    [! $modifiable] ? readonly
>

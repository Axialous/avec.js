@script [
    $type = 'password'
    $visible = ':)'

    $basculer_visibilite_mot_de_passe = ($node) =>
    {
        const $conteneur = $node.closest('.champ-mot-de-passe')
        const $input = $conteneur.querySelector('input[type="password"], input[type="text"]')
        if (!$input)
            return

        const est_visible = $input.type === 'text'
        $input.type = est_visible ? 'password' : 'text'
        $type = est_visible ? 'password' : 'text'
        $visible = est_visible ? ':)' : ':('
        $input.focus()
    }

    $mettre_a_jour_barre_progression = ($node) =>
    {
        const $conteneur = $node.closest('.champ-mot-de-passe')
        const $barre = $conteneur.querySelector('.barre-progression')
        if (!$barre)
            return

        const longueur_minimale = parseInt($barre.dataset.minlength)
        const longueur_actuelle = $node.value.length
        const pourcentage = Math.min((longueur_actuelle / longueur_minimale) * 100, 100)
        $barre.style.width = `calc((100% - 1rem) / 100 * ${pourcentage} + 0.125rem)`
    }
]

@style [
    .champ-mot-de-passe {
        position: relative;
        width: 100%;
    }

    .champ-mot-de-passe > input {
        width: 100%;
        height: 2rem;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        appearance: none;
        -webkit-appearance: none;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
    }

    .champ-mot-de-passe > input.modifiable {
        padding-right: 1.875rem;
    }

    .champ-mot-de-passe > input[minlength] {
        height: calc(2rem + 0.4375rem);
        padding-bottom: calc(0.375rem + 0.4375rem);
    }

    .champ-mot-de-passe > input[readonly] {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-mot-de-passe > input::placeholder {
        color: var(--c-plus);
        font-style: italic;
    }

    .champ-mot-de-passe > input::-ms-reveal {
        display: none;
    }

    .bascule {
        position: absolute;
        right: 0.25rem;
        top: 0.25rem;
        bottom: 0.25rem;

        display: flex;

        border-radius: 0 0.25rem 0.25rem 0;

        --c-flux: var(--c-plus);
    }

    .barre-progression {
        position: absolute;
        top: 1.875rem;
        left: 0.4375rem;

        height: 0.125rem;
        width: 0.125rem;

        background-color: var(--c-plus);
        border-radius: 0.0625rem;

        transition: width var(--d-animation);
    }
]

@args [
    $etiquette, $nom
    $requis : :)
    $valeur : ''
    $modifiable : :)
    $longueur_minimale : :(
    $longueur_maximale : :(
]

<div .champ-mot-de-passe>
    <input
        [$modifiable] ? .modifiable
        name="$nom"
        type="password"
        placeholder="$etiquette"
        value="$valeur"
        [$requis] ? required
        [! $modifiable] ? readonly
        [$longueur_minimale] ? minlength="$longueur_minimale"
        [$longueur_maximale] ? maxlength="$longueur_maximale"
        [$longueur_minimale] ? @input="$mettre_a_jour_barre_progression($node)"
    >

    @if [$modifiable]
        <button
            .bascule
            type="button"
            @click="$basculer_visibilite_mot_de_passe($node)"
        >
            icone-oeil [$visible]

    @if [$longueur_minimale]
        <div .barre-progression data-minlength="$longueur_minimale"></div>

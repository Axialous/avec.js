@style [
    .champ-texte {
        width: 100%;

        border: 0.125rem solid var(--c-vif);
        border-radius: 0.5rem;
        padding: 0.375rem;

        --c-focus: var(--c-vif);
        --p-fonte: var(--p-champ);
    }

    .champ-texte[readonly] {
        cursor: not-allowed;

        --c-flux: var(--c-vif);
    }

    .champ-texte::placeholder {
        color: var(--c-moins);
    }
]

@args [$etiquette, $nom, $requis : :), $valeur : '', $modifiable : :)]

<input
    .champ-texte
    name="$nom"
    type="text"
    placeholder="$etiquette"
    value="$valeur"
    [$requis] ? required
    [! $modifiable] ? readonly
>

@script [
    $envoyer_formulaire = ($node, $event) =>
    {
        $event.preventDefault()
        $fonction($node, $event)
    }
]

@style [
    .formulaire {
        align-items: center;
    }
]

@args [$fonction]

<form .formulaire @submit="$envoyer_formulaire($node, $event)">
    @stud

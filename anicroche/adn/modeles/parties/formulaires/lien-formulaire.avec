@script [
    const demarrer_compte_a_rebours = ($node, $vars, delai) =>
    {
        const compte_a_rebours = $node.querySelector('.compte-a-rebours')

        if ($vars.chronometre)
        {
            clearInterval($vars.chronometre)
            $vars.chronometre = null
        }

        if (delai <= 0)
        {
            $node.disabled = false

            if (compte_a_rebours)
            {
                compte_a_rebours.textContent = ''
            }

            return
        }

        let restant = delai

        const actualiser = () =>
        {
            if (!compte_a_rebours) return
            compte_a_rebours.textContent = ` (${restant} s)`
        }

        $node.disabled = true
        actualiser()

        const chronometre = setInterval(() =>
        {
            restant -= 1

            if (restant <= 0)
            {
                clearInterval(chronometre)
                $vars.chronometre = null
                $node.disabled = false

                if (compte_a_rebours)
                {
                    compte_a_rebours.textContent = ''
                }

                return
            }

            actualiser()
        }, 1000)

        $vars.chronometre = chronometre
    }

    $monter_lien_formulaire = ($node, $vars, $delai) =>
    {
        const delai = Math.max(0, Math.floor(Number($delai) || 0))

        $vars.delai = delai

        demarrer_compte_a_rebours($node, $vars, delai)
    }

    $demonter_lien_formulaire = ($vars) =>
    {
        if (!$vars.chronometre) return

        clearInterval($vars.chronometre)
        $vars.chronometre = null
    }

    $clic_lien_formulaire = async ($node, $vars, $fonction) =>
    {
        if ($node.disabled) return

        await $fonction($node)

        if ($vars.delai > 0)
        {
            demarrer_compte_a_rebours($node, $vars, $vars.delai)
        }
    }
]

@style [
    .lien-formulaire {
        display: inline;
        width: fit-content;

        text-decoration: underline transparent;

        transition: text-decoration-color var(--d-animation);
    }

    .lien-formulaire:hover {
        text-decoration-color: var(--c-flux);
    }

    .lien-formulaire:disabled {
        cursor: not-allowed;
        text-decoration-color: transparent;
    }
]

@args [
    $fonction
    $delai : :(
]

<button
    .lien-formulaire
    type="button"
    @mount="$monter_lien_formulaire($node, $vars, $delai)"
    @unmount="$demonter_lien_formulaire($vars)"
    @click="$clic_lien_formulaire($node, $vars, $fonction)"
>
    @stud

    @if [$delai]
        <span .compte-a-rebours>

@style [
    .lien-soumission {
        display: inline;
        width: fit-content;

        text-decoration: underline transparent;

        transition: text-decoration-color var(--d-animation);
    }

    .lien-soumission:hover {
        text-decoration-color: var(--c-flux);
    }
]

@args [$type : :(]

<button
    .lien-soumission
    type="submit"
    [$type] ? value="$type"
>
    @stud

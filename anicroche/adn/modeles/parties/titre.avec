@style [
    .titre {
        text-wrap: balance;

        --l-fonte: 1.5em;
        --p-fonte: var(--p-titre);
    }

    .titre.centre {
        text-align: center;
    }
]

@args [$type : classique]

@if [$type = centre]
    <h1 .titre .centre>
        @stud
@else
    <h1 .titre>
        @stud

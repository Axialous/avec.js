@style [
    .section-chargement {
        margin: var(--l-marge);
        cursor: wait;

        --l-marge: -1rem;
        --f-fond:  var(--f-degrade-vif);
        --c-fond:  var(--c-vif);
        --c-flux:  var(--c-creme)
    }

    .page.entree .section-chargement,
    .page.sortie .section-chargement {
        cursor: default;
    }
]

section [chargement, centree]
    animation-chargement
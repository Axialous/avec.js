@script [
    $envoyer_formulaire_courriel = ($node, $event) =>
    {
        $mode_formulaire = $event.submitter.value

        data = new FormData($node)
        $courriel_formulaire = data.get('courriel')

        $basculer_vers_onglet_suivant($node)
    }

    $envoyer_formulaire_mot_de_passe = ($node, $event) =>
    {
        data = new FormData($node)

        if (confirm("Simulation : est-ce le bon mot de passe ?"))
        {
            alert(`Connexion avec le courriel "${data.get('courriel')}"`)
            $navigate("/")
        }
        else
        {
            $erreur_mot_de_passe = "L'adresse électronique ou le mot de passe est invalide"
        }
    }

    $envoyer_formulaire_clef = ($node, $event) =>
    {
        data = new FormData($node)
        $clef_formulaire = data.get('clef')

        if (confirm("Simulation : est-ce la bonne clef ?"))
        {
            type = confirm("Simulation : est-ce que le compte existe déjà ?") ? 'connexion' : 'inscription'
            if (type == 'inscription')
            {
                $basculer_vers_onglet_suivant($node)
            }
            else if (type == 'connexion')
            {
                alert(`Connexion avec le courriel "${data.get('courriel')}"`)
                $navigate("/")
            }
        }
        else
        {
            $erreur_clef = "La clef de validation est invalide"
        }
    }

    $envoyer_formulaire_inscription = ($node, $event) =>
    {
        data = new FormData($node)

        if (confirm("Simulation : est-ce que la clef de validation est encore valide ?"))
        {
            alert(`Inscription avec le courriel "${data.get('courriel')}"`)
            $navigate("/")
        }
        else
        {
            $erreur_inscription = "La clef de validation a expiré"
        }
    }
]

@args [$etape]

@if [$etape = courriel]
    section [connexion, centree]
        titre [centre]
            "Connectez-vous ou inscrivez-vous"
        carte
            formulaire [$envoyer_formulaire_courriel]
                champ-courriel ["Adresse électronique", courriel]
                bouton-soumission [clef]
                    <span>
                        "Continuer"
                    icone-fleche-droite
                lien-soumission [mot_de_passe]
                    "Me connecter avec mon mot de passe"

@else-if [$etape = mot_de_passe]
    section [connexion, centree]
        titre [centre]
            "Saisissez votre mot de passe"
        carte
            formulaire [$envoyer_formulaire_mot_de_passe]
                @if [$erreur_mot_de_passe]
                    erreur-formulaire
                        "$erreur_mot_de_passe"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe ["Mot de passe", mot_de_passe]
                ligne
                    bouton-formulaire [$basculer_vers_onglet_precedant]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = clef]
    section [connexion, centree]
        titre [centre]
            "Saisissez la clef de validation"
        carte
            formulaire [$envoyer_formulaire_clef]
                @if [$erreur_clef]
                    erreur-formulaire
                        "$erreur_clef"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-clef ["Clef de validation", clef]
                lien-formulaire
                    "Renvoyer la clef"
                ligne
                    bouton-formulaire [$basculer_vers_onglet_precedant]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = inscription]
    section [connexion, centree]
        titre [centre]
            "Définissez un mot de passe fort"
        carte
            formulaire [$envoyer_formulaire_inscription]
                @if [$erreur_inscription]
                    erreur-formulaire
                        "$erreur_inscription"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe [
                    "Mot de passe", mot_de_passe
                    $longueur_minimale : 12
                    $longueur_maximale : 128
                ]
                ligne
                    bouton-formulaire [$basculer_vers_onglet_precedant]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

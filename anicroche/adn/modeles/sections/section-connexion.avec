@script [
    $envoyer_formulaire_courriel = ($node, $event) =>
    {
        $mode_formulaire = $event.submitter.value

        data = new FormData($node)

        if ($mode_formulaire == 'clef')
        {
            let reponse = $courriels_clefs.has(data.get('courriel'))

            if (!reponse)
            {
                reponse = confirm("Simulation : est-ce que la clef d'activation a été créée ?")
            }

            if (reponse)
            {
                $courriel_formulaire = data.get('courriel')
                $basculer_vers_onglet_suivant($node)
                $courriels_clefs.add($courriel_formulaire)
            }
            else
            {
                $erreur_courriel = "Veuillez réessayer dans une minute"
            }
        }
        else if ($mode_formulaire == 'mot_de_passe')
        {
            $basculer_vers_onglet_suivant($node)
        }
    }

    $envoyer_formulaire_mot_de_passe = ($node, $event) =>
    {
        data = new FormData($node)

        let reponse = confirm("Simulation : est-ce le bon mot de passe ?")

        if (reponse)
        {
            alert(`Connexion avec le courriel "${data.get('courriel')}"`)
            $navigate_to("/")
        }
        else
        {
            $erreur_mot_de_passe = "L'adresse électronique ou le mot de passe est invalide"
        }
    }

    $renvoyer_clef = ($node, $event) =>
    {
        let reponse = confirm("Simulation : est-ce que la clef d'activation a été créée ?")

        if (reponse)
        {
            $succes_clef   = "Une nouvelle clef a été envoyée"
            $erreur_clef = ":("
        }
        else
        {
            $erreur_clef = "Veuillez réessayer dans une minute"
            $succes_clef   = ":("
        }
    }

    $envoyer_formulaire_clef = ($node, $event) =>
    {
        data = new FormData($node)
        $clef_formulaire = data.get('clef')

        let reponse = confirm("Simulation : est-ce la bonne clef ?")

        if (reponse)
        {
            type = confirm("Simulation : est-ce que le compte existe déjà ?") ? 'connexion' : 'inscription'
            if (type == 'inscription')
            {
                $basculer_vers_onglet_suivant($node)
            }
            else if (type == 'connexion')
            {
                alert(`Connexion avec le courriel "${data.get('courriel')}"`)
                $navigate_to("/")
            }
        }
        else
        {
            $succes_clef = ':('
            $erreur_clef = "La clef de validation est invalide"
        }
    }

    $envoyer_formulaire_inscription = ($node, $event) =>
    {
        data = new FormData($node)

        let reponse = confirm("Simulation : est-ce que la clef de validation est encore valide ?")

        if (reponse)
        {
            alert(`Inscription avec le courriel "${data.get('courriel')}"`)
            $navigate_to("/")
        }
        else
        {
            $erreur_inscription = "La clef de validation a expiré"
        }
    }

    $basculer_vers_section_courriel = ($node) =>
    {
        $erreur_courriel = ':('
        $basculer_vers_onglet_precedant($node)
    }

    $basculer_vers_section_clef = ($node) =>
    {
        $succes_clef = ':('
        $erreur_clef = ':('
        $basculer_vers_onglet_precedant($node)
    }
]

@args [$etape]

@if [$etape = courriel]
    section [connexion, centree]
        titre [centre]
            "Connectez-vous ou inscrivez-vous"
        carte
            formulaire [$envoyer_formulaire_courriel]
                @if [$erreur_courriel]
                    erreur-formulaire
                        "$erreur_courriel"
                champ-courriel ["Adresse électronique", courriel]
                bouton-soumission [clef]
                    <span>
                        "Continuer"
                    icone-fleche-droite
                lien-soumission [mot_de_passe]
                    "Me connecter avec mon mot de passe"

@else-if [$etape = mot_de_passe]
    section [connexion, centree]
        titre [centre]
            "Saisissez votre mot de passe"
        carte
            formulaire [$envoyer_formulaire_mot_de_passe]
                @if [$erreur_mot_de_passe]
                    erreur-formulaire
                        "$erreur_mot_de_passe"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe ["Mot de passe", mot_de_passe]
                ligne
                    bouton-formulaire [$basculer_vers_section_courriel]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = clef]
    section [connexion, centree]
        titre [centre]
            "Saisissez la clef de validation"
        carte
            formulaire [$envoyer_formulaire_clef]
                @if [$succes_clef]
                    succes-formulaire
                        "$succes_clef"
                @if [$erreur_clef]
                    erreur-formulaire
                        "$erreur_clef"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-clef ["Clef de validation", clef]
                lien-formulaire [$renvoyer_clef, 5]
                    "Renvoyer la clef"
                ligne
                    bouton-formulaire [$basculer_vers_section_courriel]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = inscription]
    section [connexion, centree]
        titre [centre]
            "Définissez un mot de passe fort"
        carte
            formulaire [$envoyer_formulaire_inscription]
                @if [$erreur_inscription]
                    erreur-formulaire
                        "$erreur_inscription"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe [
                    "Mot de passe", mot_de_passe
                    $longueur_minimale : 12
                    $longueur_maximale : 128
                ]
                ligne
                    bouton-formulaire [$basculer_vers_section_clef]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

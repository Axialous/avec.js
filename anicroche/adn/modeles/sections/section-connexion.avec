@script [
    $envoyer_formulaire_courriel = async ($node, $event) =>
    {
        $mode_formulaire = $event.submitter.value

        data = new FormData($node)

        if ($mode_formulaire == 'clef')
        {
            const deja_envoyee = $courriels_clefs.has(data.get('courriel'))
            let reponse = null

            if (!deja_envoyee)
            {
                reponse = await $create('clef', {type: 'authentification', coordonnee: data.get('courriel')})
            }

            if (deja_envoyee || !reponse.error)
            {
                if (reponse)
                    $ids.push(reponse.data.id)
                $courriel_formulaire = data.get('courriel')
                $basculer_vers_onglet_suivant($node)
                $courriels_clefs.add($courriel_formulaire)
            }
            else
            {
                $erreur_courriel = "Veuillez réessayer dans trente secondes"
            }
        }
        else if ($mode_formulaire == 'mot_de_passe')
        {
            $courriel_formulaire = data.get('courriel')
            $basculer_vers_onglet_suivant($node)
        }
    }

    $envoyer_formulaire_mot_de_passe = async ($node, $event) =>
    {
        data = new FormData($node)

        let reponse = await $create('connexion', {
            coordonnee: data.get('courriel'),
            mot_de_passe: data.get('mot_de_passe')
        })

        if (!reponse.error)
        {
            $navigate_to("/")
        }
        else
        {
            $erreur_mot_de_passe = "L'adresse électronique ou le mot de passe est invalide"
        }
    }

    $renvoyer_clef = async ($node, $event) =>
    {
        let reponse = await $create('clef', {type: 'authentification', coordonnee: $courriel_formulaire})

        if (!reponse.error)
        {
            $ids.push(reponse.data.id)
            $succes_clef   = "Une nouvelle clef a été envoyée"
            $erreur_clef = ":("
        }
        else
        {
            $erreur_clef = "Veuillez réessayer dans trente secondes"
            $succes_clef   = ":("
        }
    }

    $envoyer_formulaire_clef = async ($node, $event) =>
    {
        data = new FormData($node)
        $clef_formulaire = data.get('clef')

        let reponse = await $create('authentification', {
            coordonnee: data.get('courriel'),
            clef: data.get('clef'),
            ids: $ids
        })

        if (!reponse.error)
        {
            type = reponse.data?.type
            if (type == 'inscription')
            {
                $basculer_vers_onglet_suivant($node)
            }
            else if (type == 'connexion')
            {
                reponse = await $create('connexion', {
                    coordonnee: data.get('courriel'),
                    clef: data.get('clef'),
                    ids: $ids
                })
                if (!reponse.error)
                {
                    $navigate_to("/")
                }
                else
                {
                    $succes_clef = ':('
                    $erreur_clef = "Erreur serveur"
                }
            }
            else
            {
                $succes_clef = ':('
                $erreur_clef = "Réponse serveur invalide"
            }
        }
        else
        {
            $succes_clef = ':('
            $erreur_clef = "La clef de validation est invalide"
        }
    }

    $envoyer_formulaire_inscription = async ($node, $event) =>
    {
        data = new FormData($node)

        let reponse = await $create('inscription', {
            type_coordonnee: 'courriel',
            coordonnee: data.get('courriel'),
            clef: $clef_formulaire,
            mot_de_passe: data.get('mot_de_passe'),
            ids: $ids
        })

        if (!reponse.error)
        {
            reponse = await $create('connexion', {
                coordonnee: data.get('courriel'),
                mot_de_passe: data.get('mot_de_passe')
            })

            if (!reponse.error)
            {
                $navigate_to("/")
            }
            else
            {
                $erreur_inscription = "La connexion a échoué"
            }
        }
        else
        {
            $erreur_inscription = "La clef de validation a expiré"
        }
    }

    $basculer_vers_section_courriel = ($node) =>
    {
        $erreur_courriel = ':('
        $basculer_vers_onglet_precedant($node)
    }

    $basculer_vers_section_clef = ($node) =>
    {
        $succes_clef = ':('
        $erreur_clef = ':('
        $basculer_vers_onglet_precedant($node)
    }
]

@args [$etape]

@if [$etape = courriel]
    section [connexion, centree]
        titre [centre]
            "Connectez-vous ou inscrivez-vous"
        carte
            formulaire [$envoyer_formulaire_courriel]
                @if [$erreur_courriel]
                    erreur-formulaire
                        "$erreur_courriel"
                champ-courriel ["Adresse électronique", courriel]
                bouton-soumission [clef]
                    <span>
                        "Continuer"
                    icone-fleche-droite
                lien-soumission [mot_de_passe]
                    "Me connecter avec mon mot de passe"

@else-if [$etape = mot_de_passe]
    section [connexion, centree]
        titre [centre]
            "Saisissez votre mot de passe"
        carte
            formulaire [$envoyer_formulaire_mot_de_passe]
                @if [$erreur_mot_de_passe]
                    erreur-formulaire
                        "$erreur_mot_de_passe"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe ["Mot de passe", mot_de_passe]
                ligne
                    bouton-formulaire [$basculer_vers_section_courriel]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = clef]
    section [connexion, centree]
        titre [centre]
            "Saisissez la clef de validation"
        carte
            formulaire [$envoyer_formulaire_clef]
                @if [$succes_clef]
                    succes-formulaire
                        "$succes_clef"
                @if [$erreur_clef]
                    erreur-formulaire
                        "$erreur_clef"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-clef ["Clef de validation", clef]
                lien-formulaire [$renvoyer_clef, 30]
                    "Renvoyer la clef"
                ligne
                    bouton-formulaire [$basculer_vers_section_courriel]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

@else-if [$etape = inscription]
    section [connexion, centree]
        titre [centre]
            "Définissez un mot de passe fort"
        carte
            formulaire [$envoyer_formulaire_inscription]
                @if [$erreur_inscription]
                    erreur-formulaire
                        "$erreur_inscription"
                champ-courriel [
                    "Adresse électronique", courriel
                    $valeur : $courriel_formulaire
                    $modifiable : :(
                ]
                champ-mot-de-passe [
                    "Mot de passe", mot_de_passe
                    $longueur_minimale : 12
                    $longueur_maximale : 128
                ]
                ligne
                    bouton-formulaire [$basculer_vers_section_clef]
                        icone-fleche-gauche
                        alt
                            "Retour"
                    bouton-soumission
                        <span>
                            "Continuer"
                        icone-fleche-droite

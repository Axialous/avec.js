@script [
    $erreur_creation_profil = false

    $envoyer_formulaire_creation = async () =>
    {
        data = new FormData($node)

        const reponse = await $create('profil', {
            identifiant: data.get('identifiant'),
            pseudonyme : data.get('pseudonyme')
        })

        if (!reponse.error)
        {
            $navigate_to('/profil')
        }
        else
        {
            $erreur_creation_profil = reponse.error ?? "La création du profil a échoué"
        }
    }
]

section [creation-profil, centree]
    titre [centre]
        "Créez votre profil"
    carte
        formulaire [$envoyer_formulaire_creation]
            @if [$erreur_creation_profil]
                erreur-formulaire
                    "$erreur_creation_profil"
            choix-unique [
                "Type de profil", Type
                $choix : [
                    {etiquette : "Racine", nom : racine}
                    {etiquette : "Dérivé", nom : derive}
                ]
            ]
            champ-texte [
                "Identifiant unique", identifiant
            ]
            champ-texte [
                "Pseudonyme", pseudonyme
            ]
            bouton-soumission
                "Créer le profil"

@script [
    $erreur_creation_profil = false

    $options = $compte.is_gerant_of_profils
        .filter(profil => !profil.identifiant.includes('.'))
        .map(profil => ({
            etiquette: profil.identifiant,
            nom: profil.identifiant
        }))
    
    $type = $options.length < 5 ? 'racine' : 'derive'

    $mettre_a_jour_type = () =>
    {
        $type = $node.value
    }

    $envoyer_formulaire_creation = async () =>
    {
        data = new FormData($node)

        const identifiant = $type == 'derive'
            ? `${data.get('base')}.${data.get('identifiant')}`
            : data.get('identifiant')
        const pseudonyme = data.get('pseudonyme')

        const reponse = await $create('profil', {
            identifiant: identifiant,
            pseudonyme : pseudonyme
        })

        console.log(reponse)

        if (!reponse.error)
        {
            const reponse_compte = await $search('moi')
            if (!reponse_compte.error)
            {
                $compte = reponse_compte.data
                $selectionner_profil($compte.is_gerant_of_profils.find(profil => profil.identifiant == identifiant).id)
            }
            $navigate_to('/profil')
        }
        else
        {
            $erreur_creation_profil = reponse.error ?? "La création du profil a échoué"
        }
    }
]

@style [
    .section-creation-profil .champ[data-disabled] {
        display: none;
    }
]

section [creation-profil, centree]
    titre [centre]
        "Créez votre profil"
    carte
        formulaire [$envoyer_formulaire_creation]
            @if [$erreur_creation_profil]
                erreur-formulaire
                    "$erreur_creation_profil"
            @if [_ $compte.is_gerant_of_profils > 0 & _ $options < 5]
                choix-unique [
                    "Type de profil", type
                    $choix : [
                        {etiquette : "Nouveau", nom : racine}
                        {etiquette : "Suffixé", nom : derive}
                    ]
                    $action : $mettre_a_jour_type()
                ]
            ligne
                choix-option [
                    "Base", base
                    $choix : $options
                    $desactive : $type = racine
                    $prefixe : @
                ]
                champ-texte [
                    $etiquette : [$type = racine] ? "Identifiant unique" : "Suffixe"
                    identifiant
                    $prefixe : [$type = racine] ? @ : .
                    $regle : "/^(?=.{1,32}$)(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*$/"
                    $indice : "Autorisés : a-z, 0-1, -"
                ]
            champ-texte [
                "Nom d'affichage", pseudonyme
            ]
            bouton-soumission
                "Créer le profil"

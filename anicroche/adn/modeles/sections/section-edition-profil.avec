@script [
    $erreur_edition_profil = ':('

    $envoyer_formulaire_edition = async ($node, $event) =>
    {
        data = new FormData($node)

        const reponse = await $create('profil', {
            identifiant: data.get('identifiant'),
            pseudonyme : data.get('pseudonyme')
        })

        if (!reponse.error)
        {
            $navigate_to('/profil')
        }
        else
        {
            $erreur_edition_profil = reponse.error ?? "La création du profil a échoué"
        }
    }
]

section [creation-profil, centree]
    titre [centre]
        "Éditez votre profil"
    carte
        formulaire [$envoyer_formulaire_edition]
            @if [$erreur_edition_profil]
                erreur-formulaire
                    "$erreur_edition_profil"
            champ-texte [
                "Identifiant", identifiant
            ]
            champ-texte [
                "Pseudonyme", pseudonyme
            ]
            bouton-soumission
                "Créer le profil"

@style [
    .section-profil .profil {
        align-items: center;
        flex-wrap: nowrap;

        --h-avatar: 6rem;
    }

    .section-profil .profil > .noms {
        min-width: 0;

        --l-ecart: 0.5rem;
    }

    .section-profil .profil > .noms > span {
        overflow: hidden;
        text-overflow: ellipsis;

        white-space: nowrap;
    }

    .section-profil .profil > .noms > .pseudonyme {
        --e-fonte: var(--e-gras);
    }
]

section [profil]
    titre
        "Votre profil"
    carte
        ligne.profil
            avatar-profil [$profil]
            <div .noms>
                <span .pseudonyme>
                    "$profil.pseudonyme"
                <span .identifiant>
                    "@$profil.identifiant"
        ligne
            bouton-ancre [/profil/edition]
                "Éditer le profil"
            bouton-ancre [#profils]
                "Changer de profil"

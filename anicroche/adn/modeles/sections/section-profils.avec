@script [
    $ps = $compte.is_gerant_of_profils
]

@style [
    .section-profils .carte-profil.selectionnee {
        z-index: 1;
        transform: translateX(calc(var(--var-i) * -11rem));
    }

    .section-profils .carte-profil:has(~ .carte.selectionnee) {
        transform: translatex(11rem);
    }
]

section [profils]
    titre
        "Vos profils"

    @if [_ $compte.is_gerant_of_profils = 0]
        <p>
            "Vous n'avez pas encore créé de profil."
        bouton-ancre [/profil/creation]
            "Créer un profil"

    @else
        defilement [horizontal]
            @for-each [$i, $p] of [$ps]
                carte-profil [
                    $p
                    $selectionnee : $p.id = $profil.id
                    $action : [$p.id != $profil.id] ? $selectionner_profil($p.id) : :(
                    $alt : "Basculer sur le profil $p.identifiant"
                ]

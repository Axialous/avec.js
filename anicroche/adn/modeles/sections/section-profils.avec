@script [
    $selectionner_profil = (id) =>
    {
        $profil = $compte.is_gerant_of_profils.find(p => p.id == id)
    }
]

@style [
    .section-profils .liste-profils {
        flex-direction: row;

        --h-avatar: 4rem;
    }

    .section-profils .liste-profils .carte {
        flex: none;
        width: 10rem;
        align-items: center;
    }

    .section-profils .liste-profils .carte .noms {
        max-width: 100%;

        --l-ecart: 0.5rem;
    }

    .section-profils .liste-profils .carte .noms span {
        width: 100%;

        overflow: hidden;
        text-overflow: ellipsis;

        white-space: nowrap;
        text-align: center;
    }

    .section-profils .liste-profils .carte .pseudonyme {
        --e-fonte: var(--e-gras);
    }
]

section [profils]
    titre
        "Vos profils"
    "$profil.pseudonyme"

    @if [_ $compte.is_gerant_of_profils = 0]
        <p>
            "Vous n'avez pas encore créé de profil."
        bouton-ancre [/profil/creation]
            "Créer un profil"

    @else
        defilement.liste-profils [horizontal]
            @for-each [$i, $p] of [$compte.is_gerant_of_profils]
                carte [$selectionnee : $profil.id = $p.id]
                    @if [$profil.id != $p.id]
                        boite-action [
                            $selectionner_profil($p.id)
                            $etendue : :)
                            $alt : "Basculer sur le profil $p.identifiant"
                        ]
                    avatar [$p]
                    <div .noms>
                        <span .pseudonyme>
                            "$p.pseudonyme"
                        <span .identifiant>
                            "@$p.identifiant"

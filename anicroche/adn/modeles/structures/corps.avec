@script [
    $monter_corps = ($node) =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )
    }
]

@style [
    #corps {
        grid-area: 1 / 2 / 3 / 3;
        overflow: hidden;
        gap: 0;
        padding-left: var(--l-tete);

        height: 100%;

        transition: opacity var(--d-animation);
    }

    #corps.entree {
        opacity: 0;
    }

    .petit.portrait #corps {
        grid-area: 1 / 1 / 2 / 2;
    }

    #navigation {
        height: 3.5rem;

        align-items: center;
        flex-flow: row nowrap;

        padding: var(--l-marge);

        --f-fond: var(--f-degrade-vif);
        --c-fond: var(--c-vif);
        --c-flux: var(--c-creme);
    }

    #navigation span {
        white-space: nowrap;
        font-family: var(--p-titre);

        --l-fonte: 1.5rem;
        --e-fonte: 450;
    }

    #page {
        margin-left: calc(0px - var(--l-tete));
        position: relative;
        flex: 1;
        overflow-y: hidden;
    }
]

<main
    #corps
    @mount="$monter_corps($node)"
>
    <nav #navigation>
        routeur navigation

    <section #page>
        routeur page

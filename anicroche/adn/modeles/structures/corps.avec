@script [
    $monter_corps = ($node) =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )
    }
]

@style [
    #corps {
        grid-area: 1 / 2 / 3 / 3;
        overflow: hidden;
        gap: 0;
        padding-left: var(--l-tete);

        height: 100%;

        transition: opacity var(--d-animation);
    }

    #corps.entree {
        opacity: 0;
    }

    .petit.portrait #corps {
        grid-area: 1 / 1 / 2 / 2;
    }

    #page {
        margin-left: calc(0px - var(--l-tete));
        position: relative;
        flex: 1;
        height: 100%;
    }
]

<main
    #corps
    @mount="$monter_corps($node)"
>
    <section #page>
        routeur

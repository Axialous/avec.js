@script [
    $monter_corps = () =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )
    }
]

@style [
    #corps {
        grid-area: 1 / 2 / 3 / 3;
        overflow: hidden;
        gap: 0;
        padding-left: var(--l-tete);

        height: 100%;

        transition: opacity var(--d-animation);
    }

    #corps.entree {
        opacity: 0;
    }

    .petit.portrait #corps {
        grid-area: 1 / 1 / 2 / 2;
    }

    #page {
        margin-left: calc(0px - var(--l-tete));
        position: relative;
        flex: 1;
        height: 100%;
    }

    #page::before {
        content: "";

        position: absolute;
        z-index: 99;
        top: 0;
        right: 0;
        left: var(--l-tete);

        height: var(--h-navigation);

        background: var(--f-fond);

        pointer-events: none;
        opacity: 0;
        transition: opacity var(--d-animation);

        --f-fond: var(--f-degrade-vif);
        --c-fond: var(--c-vif);
    }

    #page::after {
        content: "";

        position: absolute;
        z-index: 99;
        top: var(--h-navigation);
        right: 0;
        bottom: 0;
        left: var(--l-tete);

        background: var(--f-fond);

        pointer-events: none;
        opacity: 0;
        transition: opacity var(--d-animation);

        --f-fond: var(--c-theme);
        --c-fond: var(--c-theme);
    }

    .petit.portrait #page::after {
        bottom: var(--h-tete);
    }

    #page:has(> .page.entree)::before,
    #page:has(> .page.sortie)::before,
    #page:has(> .page.entree)::after,
    #page:has(> .page.sortie)::after {
        opacity: 100%;
    }
]

<main
    #corps
    @mount="$monter_corps()"
>
    <section #page>
        routeur

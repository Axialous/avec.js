@script [
    $monter_fond = ($node) =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )
    }
]

@style [
    #fond {
        position: fixed;
        z-index: -1;
        inset: 0;

        display: grid;

        gap: 0;

        transition: opacity var(--d-animation);
    }

    #fond.entree {
        opacity: 0;
    }

    #fond .tete {
        --f-fond: var(--c-analogue);
        --c-fond: var(--c-analogue);
    }

    #fond .corps {
        --f-fond: var(--c-theme);
        --c-fond: var(--c-theme);
    }

    .grand #fond,
    .petit.paysage #fond {
        grid-template-columns: var(--l-tete) 1fr;
    }

    .petit.portrait #fond {
        grid-template-columns: none;
        grid-template-rows: 1fr 3.5rem;
    }

    .petit.portrait #fond .tete {
        grid-row: 2;
    }
]

<div
    #fond
    @mount="$monter_fond($node)"
>
    <div .tete>
    <div .corps>

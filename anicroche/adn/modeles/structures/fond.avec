@script [
    $monter_fond = ($node) =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )
    }
]

@style [
    #fond {
        position: fixed;
        z-index: -1;
        inset: 0;

        display: grid;

        gap: 0;

        transition: opacity var(--d-animation);

        --f-fond: var(--c-analogue);
        --c-fond: var(--c-analogue);
    }

    #fond.entree {
        opacity: 0;
    }

    #fond .empreinte-tete {
        --f-fond: var(--c-analogue);
        --c-fond: var(--c-analogue);
    }

    #fond .empreinte-navigation {
        transition: opacity var(--d-animation);

        --f-fond: var(--f-degrade-vif);
        --c-fond: var(--c-vif);
    }

    .interieur #fond .empreinte-navigation {
        opacity: 0%;
    }

    #fond .empreinte-corps {
        --f-fond: var(--c-theme);
        --c-fond: var(--c-theme);
    }

    .grand #fond,
    .petit.paysage #fond {
        grid-template-columns: var(--l-tete) 1fr;
        grid-template-rows: var(--h-navigation) 1fr;
    }

    .grand #fond .empreinte-tete,
    .petit.paysage #fond .empreinte-tete {
        grid-column: 1;
        grid-row: 1 / 3;
    }

    .grand #fond .empreinte-navigation,
    .petit.paysage #fond .empreinte-navigation {
        grid-column: 2;
        grid-row: 1;
    }

    .grand #fond .empreinte-corps,
    .petit.paysage #fond .empreinte-corps {
        grid-column: 2;
        grid-row: 2;
    }

    .petit.portrait #fond {
        grid-template-columns: 1fr;
        grid-template-rows: var(--h-navigation) 1fr 3.5rem;
    }

    .petit.portrait #fond .empreinte-navigation {
        grid-row: 1;
    }

    .petit.portrait #fond .empreinte-corps {
        grid-row: 2;
    }

    .petit.portrait #fond .empreinte-tete {
        grid-row: 3;
    }
]

<div
    #fond
    @mount="$monter_fond($node)"
>
    <div .empreinte-tete>
    <div .empreinte-navigation>
    <div .empreinte-corps>

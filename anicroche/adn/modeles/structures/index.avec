@script [
    $format      = `petit`
    $orientation = `paysage`
    $pointeur    = `precis`
    $theme       = `clair`
    $defilement  = `sommet`

    const actualiser_format = () =>
    {
        const w = window.innerWidth
        const h = window.innerHeight

        $format = w > 1024 ? `grand` : `petit`
        $orientation = w > h ? `paysage` : `portrait`

        document.documentElement.classList.remove(`grand`,   `petit`, `paysage`, `portrait`)
        document.documentElement.classList.add($format, $orientation)
    }

    const actualiser_pointeur = (media_query) =>
    {
        $pointeur = media_query.matches ? `grossier` : `precis`

        document.documentElement.classList.remove(`grossier`, `precis`)
        document.documentElement.classList.add($pointeur)
    }

    const actualiser_theme = (media_query_theme) =>
    {
        $theme = media_query_theme.matches ? `sombre` : `clair`

        document.documentElement.classList.remove(`clair`, `sombre`)
        document.documentElement.classList.add($theme)
    }

    $actualiser_defilement = (defilement) =>
    {
        if (defilement == `interieur`)
        {
            $defilement = `interieur`
            document.documentElement.classList.remove(`sommet`)
            document.documentElement.classList.add(`interieur`)
        }
        else if (defilement == `sommet`)
        {
            $defilement = `sommet`
            document.documentElement.classList.remove(`interieur`)
            document.documentElement.classList.add(`sommet`)
        }
    }

    const media_query_pointeur = window.matchMedia(`(pointer: coarse)`)
    const media_query_theme = window.matchMedia(`(prefers-color-scheme: dark)`)

    actualiser_format()
    actualiser_pointeur(media_query_pointeur)
    actualiser_theme(media_query_theme)
    $actualiser_defilement(`sommet`)

    window.addEventListener(`resize`, actualiser_format)
    media_query_pointeur.addEventListener(`change`, actualiser_pointeur)
    media_query_theme.addEventListener(`change`, actualiser_theme)
]

@style [
    @font-face {
        font-family: "Eczar";
        src: url("/systeme/fontes/Eczar.ttf") format("truetype");
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
    }

    * {
        gap: var(--l-ecart);

        background:      var(--f-fond);
        font-family:     var(--p-fonte);
        font-size:       var(--l-fonte);
        font-weight:     var(--e-fonte);
        line-height:     1;
        color:           var(--c-flux);
        scrollbar-color: var(--c-flux) transparent;

        outline-style:  solid;
        outline-color:  transparent;
        outline-width:  0.125rem;
        outline-offset: 0.125rem;

        transition: outline-color var(--d-animation);

        --f-fond: transparent;
        --c-focus: --c-flux;
    }

    *:focus-visible {
        outline-color: var(--c-focus);
    }

    *::selection {
        color: var(--c-fond);
        background: var(--c-flux);
    }

    a, button {
        cursor: pointer;
    }

    path {
        stroke: var(--c-flux);
        stroke-width: 0.125rem;
        stroke-linejoin: round;
        stroke-linecap: round;
        fill: none;
    }

    html {
        overflow: hidden;

        --p-fonte:  var(--p-texte);
        --p-titre:  'Eczar', serif;
        --p-texte:  sans-serif;
        --p-bouton: monospace;
        --p-champ:  monospace;

        --l-fonte: 1rem;
        --l-ligne: 1;
        --l-ecart: 1rem;
        --l-marge: 1rem;
        --l-blur: 4rem;
        --l-tete: 10.625rem;
        --h-navigation: 3.5rem;

        --e-fonte:  var(--e-texte);
        --e-titre:  450;
        --e-texte:  400;
        --e-bouton: 600;

        --d-animation:  500ms;

        --t-theme: 30;

        --s-theme: 0.2;

        --p-trans: 50%;

        --c-noir:  oklch(0.00 0.00 0);
        --c-blanc: oklch(1.00 0.00 0);
        --c-trans: oklch(1.00 0.00 0 / 0%);

        --c-noir-trans:  oklch(0.00 0.00 0 / var(--p-trans));
        --c-blanc-trans: oklch(1.00 0.00 0 / var(--p-trans));

        --c-boue:  oklch(0.25 calc(var(--s-theme) / 20) var(--t-theme));
        --c-creme: oklch(0.95 calc(var(--s-theme) / 20) var(--t-theme));

        --c-boue-trans:  oklch(0.25 calc(var(--s-theme) / 20) var(--t-theme) / var(--p-trans));
        --c-creme-trans: oklch(0.95 calc(var(--s-theme) / 20) var(--t-theme) / var(--p-trans));

        --c-sombre: oklch(0.45 var(--s-theme) var(--t-theme));
        --c-vif:    oklch(0.65 var(--s-theme) var(--t-theme));
        --c-clair:  oklch(0.85 var(--s-theme) var(--t-theme));

        --c-sombre-trans: oklch(0.45 var(--s-theme) var(--t-theme) / var(--p-trans));
        --c-vif-trans:    oklch(0.65 var(--s-theme) var(--t-theme) / var(--p-trans));
        --c-clair-trans:  oklch(0.85 var(--s-theme) var(--t-theme) / var(--p-trans));

        --f-fond: var(--c-theme);
        --c-fond: var(--c-theme);
        --c-flux: var(--c-inverse);
    }

    html.petit {
        --h-navigation: 3rem;
    }

    html.petit.paysage {
        --l-tete: 3.5rem;
    }

    html.petit.portrait {
        --l-tete: 0rem;
    }

    .clair {
        color-scheme: light;

        --c-theme:    var(--c-blanc);
        --c-analogue: var(--c-creme);
        --c-inverse:  var(--c-boue);

        --c-theme-trans:    var(--c-blanc-trans);
        --c-analogue-trans: var(--c-creme-trans);
        --c-inverse-trans:  var(--c-boue-trans);

        --c-plus:     var(--c-clair);
        --c-moins:    var(--c-sombre);

        --c-plus-trans:     var(--c-clair-trans);
        --c-moins-trans:    var(--c-sombre-trans);

        --f-degrade-vif: linear-gradient(90deg, var(--c-vif), var(--c-clair));
        --f-degrade-vif-trans: linear-gradient(90deg, var(--c-vif-trans), var(--c-clair-trans));
    }

    .sombre {
        color-scheme: dark;

        --c-theme:    var(--c-noir);
        --c-analogue: var(--c-boue);
        --c-inverse:  var(--c-creme);

        --c-theme-trans:    var(--c-noir-trans);
        --c-analogue-trans: var(--c-boue-trans);
        --c-inverse-trans:  var(--c-creme-trans);

        --c-plus:     var(--c-sombre);
        --c-moins:    var(--c-clair);

        --c-plus-trans:     var(--c-sombre-trans);
        --c-moins-trans:    var(--c-clair-trans);

        --f-degrade-vif: linear-gradient(90deg, var(--c-sombre), var(--c-vif));
        --f-degrade-vif-trans: linear-gradient(90deg, var(--c-sombre-trans), var(--c-vif-trans));
    }

    body {
        width: 100vw;
        height: 100vh;

        gap: 0;
    }
]

-base

?chargement

@style [

    #logo {
        --c-flux: var(--c-vif);
    }

    .interieur #logo {
        --c-flux: var(--c-moins);
    }

    #logo > a {
        --l-ecart: 0.5rem;
    }

    #logo .logotype-anicroche {
        height: 1.5rem;

        --l-fonte: 1.5rem;
    }

    #logo svg {
        overflow: visible;
    }

    #logo path {
        filter: drop-shadow(0 0 1rem var(--c-theme));
        transition: stroke var(--d-animation);
    }

    .petit #logo .logotype-anicroche,
    .petit.portrait #logo {
        display: none;
    }

    .petit #logo .icone {
        margin: -0.25rem 0;
    }
]

<div #logo>
    ancre-boite [/, Anicroche]
        icone-anicroche
        logotype-anicroche

@style [
    #menu {
        flex: 1;

        --l-ecart: 2rem;
    }

    #menu span {
        --e-fonte: var(--e-texte);
        --p-fonte: var(--p-texte);
    }

    .grand #menu .alt,
    .petit #menu span:not(.alt) {
        display: none;
    }

    .petit #menu {
        justify-content: flex-end;

        --l-ecart: 1rem;
    }

    .petit.portrait #menu {
        justify-content: space-around;
        flex-direction: row;
    }
]

<nav #menu>
    ancre-boite [/, Accueil]
        icone-maison
        <span>
            "Accueil"

    ancre-boite [/explorer, Explorer]
        icone-arc
        <span>
            "Explorer"

    ancre-boite [/creer, Créer]
        icone-baguette
        <span>
            "Créer"

    ancre-boite [/autre, Autre]
        icone-bonbon
        <span>
            "Autre"

    @if [$connecte]
        ancre-boite [/profil, Profil]
            icone-masque
            <span>
                "Profil"
    @else
        ancre-boite [/connexion, Profil]
            icone-masque
            <span>
                "Profil"

@style [
    .navigation {
        position: absolute;
        top: 0;
        left: var(--l-tete);
        right: 0;
        z-index: 5;

        height: var(--h-navigation);
        padding: var(--l-marge);

        flex-direction: row;

        --c-fond: var(--c-vif);
        --c-flux: var(--c-creme);
    }

    .interieur .navigation {
        --c-fond: var(--c-analogue);
        --c-flux: var(--c-inverse);
    }

    .navigation::before {
        content: "";
        transform: translateZ(0);

        position: absolute;
        z-index: -1;
        top: 0;
        left: calc(0rem - var(--l-tete));

        height: 100vh;
        width: 100vw;

        background: var(--f-fond);
        backdrop-filter: blur(var(--l-blur));

        clip-path: polygon(
            0             0,
            100vw         0,
            100vw         var(--h-navigation),
            var(--l-tete) var(--h-navigation),
            var(--l-tete) 100vh,
            0             100vh
        );
        pointer-events: none;

        --f-fond: var(--c-analogue-trans);
        --c-fond: var(--c-analogue);
    }

    .petit.portrait .navigation::before {
        clip-path: polygon(
            0     0,
            100vw 0,
            100vw var(--h-navigation),
            0  var(--h-navigation),
            0  calc(100vh - var(--h-tete)),
            100vw calc(100vh - var(--h-tete)),
            100vw 100vh,
            0     100vh
        );
    }

    .navigation::after {
        content: "";

        position: absolute;
        z-index: -1;
        top: 0;
        left: 0;

        height: var(--h-navigation);
        width: 100%;

        background: var(--f-fond);

        transition: opacity var(--d-animation);

        --f-fond: var(--f-degrade-vif);
        --c-fond: var(--c-vif);
    }

    .interieur .navigation::after {
        opacity: 0;
    }

    .navigation .gauche {
        justify-content: flex-start;
    }

    .navigation .centre {
        flex: 1;
        justify-content: center;
    }

    .navigation .droite {
        justify-content: flex-end;
    }

    .navigation span {
        white-space: nowrap;
        text-align: center;

        --l-fonte: 1.5rem;
        --e-fonte: var(--e-titre);
        --p-fonte: var(--p-titre);
    }

    .navigation .bouton-onglet span {
        --l-fonte: 1.25rem;
    }

    .petit .navigation span {
        --l-fonte: 1.25rem;
    }

    .petit .navigation .bouton-onglet span {
        --l-fonte: 1rem;
    }

    .petit .navigation .icone {
        margin: -0.25rem 0;
    }

]

<div .navigation>
    @stud

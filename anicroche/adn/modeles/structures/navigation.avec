@style [
    .navigation {
        position: absolute;
        top: 0;
        left: var(--l-tete);
        right: 0;

        height: var(--h-navigation);
        padding: var(--l-marge);

        flex-direction: row;

        --f-fond: var(--f-degrade-vif);
        --c-fond: var(--c-vif);
        --c-flux: var(--c-creme);
    }

    .navigation .gauche {
        justify-content: flex-start;
    }

    .navigation .centre {
        flex: 1;
        justify-content: center;
    }

    .navigation .droite {
        justify-content: flex-end;
    }

    .navigation span {
        white-space: nowrap;
        text-align: center;

        --l-fonte: 1.5rem;
        --e-fonte: var(--e-titre);
        --p-fonte: var(--p-titre);
    }

    .navigation .bouton-onglet span {
        --l-fonte: 1.25rem;
    }

    .petit .navigation span {
        --l-fonte: 1.25rem;
    }

    .petit .navigation .bouton-onglet span {
        --l-fonte: 1rem;
    }

    .petit .navigation .icone {
        margin: -0.25rem 0;
    }

]

<div .navigation>
    @stud

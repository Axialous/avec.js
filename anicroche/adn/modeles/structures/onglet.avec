@style [
    .onglet {
        width: 100%;
        flex-shrink: 0;

        padding-top: var(--h-navigation);
        display: block;

        scroll-snap-align: end;
    }

    .onglet:not(.actif) {
        pointer-events: none;
    }

    .petit.portrait .onglet {
        padding-bottom: 3.5rem;
    }

    .onglet > .contenu {
        padding: var(--l-marge);
        min-height: 100%;
    }
]

defilement.onglet [$integration : :(]
    <div .contenu>
        @stud

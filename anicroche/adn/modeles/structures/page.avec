@script [
    $monter_page = ($node) =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )
    }

    $demonter_page = async ($node) =>
    {
        const style = getComputedStyle($node)

        const parseTime = (value) =>
        {
            return value.split(',')
                .map(v => v.trim())
                .map(v => v.endsWith('ms') ? parseFloat(v) : parseFloat(v) * 1000)
        }

        const durations = parseTime(style.transitionDuration)
        const delays = parseTime(style.transitionDelay)

        const times = durations.map((d, i) => d + (delays[i] || 0))
        const maxTime = Math.max(...times, 0)

        $node.classList.add('sortie')

        await new Promise(r => setTimeout(r, maxTime))
    }

    $basculer_vers_onglet = (n, $node) =>
    {
        const page = $node.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const cible = onglets[n - 1]
        if (!cible) return

        cible.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' })
    }
]

@style [
    .page {
        flex-direction: row;
        height: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;

        gap: 0;
        padding-left: var(--l-tete);

        transition: opacity var(--d-animation);
    }

    .page::-webkit-scrollbar {
        display: none;
    }

    .page.entree {
        opacity: 0;
    }

    .page.sortie {
        opacity: 0;
    }

    .page img {
        border-radius: 1rem;
        max-width: 100%;
    }
]

<div
    .page
    @mount="$monter_page($node)"
    @unmount="await $demonter_page($node)"
>
    @stud

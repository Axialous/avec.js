@script [
    $monter_page = () =>
    {
        $node.classList.add('entree')
        void $node.offsetWidth
        requestAnimationFrame(() =>
            requestAnimationFrame(() =>
                $node.classList.remove('entree')
            )
        )

        marquer_onglet_actif($node, 1)

        $node.addEventListener('scroll', () =>
        {
            const ratio = $node.scrollLeft / ($node.scrollWidth - $node.clientWidth)

            const barre = $node.querySelector(':scope .barre-onglets')
            if (barre)
            {
                const boutons = barre.querySelectorAll(':scope > .bouton-onglet')
                const indicateur = barre.querySelector(':scope > .indicateur')

                if (indicateur)
                {
                    const nb = boutons.length
                    indicateur.style.left = `calc((100% - ${nb - 1}rem) / ${nb} * ${ratio * (nb - 1)} + ${ratio * (nb - 1)}rem)`
                }
            }

            const onglets = $node.querySelectorAll(':scope > .onglet')
            const n = Math.round(ratio * (onglets.length - 1)) + 1
            marquer_onglet_actif($node, n)
        })
    }

    $demonter_page = async () =>
    {
        if ($vars.onglet_actif && $vars.sur_scroll_onglet)
            $vars.onglet_actif.removeEventListener('scroll', $vars.sur_scroll_onglet)

        const style = getComputedStyle($node)

        const parseTime = (value) =>
        {
            return value.split(',')
                .map(v => v.trim())
                .map(v => v.endsWith('ms') ? parseFloat(v) : parseFloat(v) * 1000)
        }

        const durations = parseTime(style.transitionDuration)
        const delays = parseTime(style.transitionDelay)

        const times = durations.map((d, i) => d + (delays[i] || 0))
        const maxTime = Math.max(...times, 0)

        $node.classList.add('sortie')

        await new Promise(r => setTimeout(r, maxTime))
    }

    $basculer_vers_onglet = (n, noeud = $node) =>
    {
        const page = noeud.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const cible = onglets[n - 1]
        if (!cible) return

        cible.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' })

        marquer_onglet_actif(page, n)
    }

    $basculer_vers_onglet_suivant = (noeud = $node) =>
    {
        const page = noeud.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const actif = [...onglets].findIndex(onglet => onglet.classList.contains('actif'))
        if (actif === -1 || actif === onglets.length - 1) return

        $basculer_vers_onglet(actif + 2, noeud)
    }

    $basculer_vers_onglet_precedant = (noeud = $node) =>
    {
        const page = noeud.closest('.page')
        if (!page) return

        const onglets = page.querySelectorAll(':scope > .onglet')
        const actif = [...onglets].findIndex(onglet => onglet.classList.contains('actif'))
        if (actif <= 0) return

        $basculer_vers_onglet(actif, noeud)
    }

    const marquer_onglet_actif = (page, n) =>
    {
        const boutons_onglets = page.querySelectorAll(':scope .bouton-onglet')
        boutons_onglets.forEach((bouton_onglet, i) =>
        {
            const actif = i === n - 1
            bouton_onglet.classList.toggle('actif', actif)
        })

        const onglets = page.querySelectorAll(':scope > .onglet')
        onglets.forEach((onglet, i) =>
        {
            const actif = i === n - 1
            onglet.classList.toggle('actif', actif)
            onglet.inert = !actif

            if (actif && $vars)
            {
                if ($vars.onglet_actif && $vars.onglet_actif !== onglet)
                    $vars.onglet_actif.removeEventListener('scroll', $vars.sur_scroll_onglet)

                $vars.onglet_actif = onglet

                $vars.sur_scroll_onglet = () =>
                {
                    $actualiser_defilement(onglet.scrollTop > 0 ? `interieur` : `sommet`)
                }

                onglet.addEventListener('scroll', $vars.sur_scroll_onglet)

                $actualiser_defilement(onglet.scrollTop > 0 ? `interieur` : `sommet`)
            }
        })
    }
]

@style [
    .page {
        flex-direction: row;
        height: 100%;
        overflow-x: hidden;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;

        gap: 0;
        padding-left: var(--l-tete);

        transition: opacity var(--d-animation);
    }

    .page.defilable {
        overflow-x: auto;
    }

    .page::-webkit-scrollbar {
        display: none;
    }

    .page img {
        border-radius: 1rem;
        max-width: 100%;
    }
]

@args [$defilable : :), $authentification : libre]

<div
    .page
    [$defilable] ? .defilable
    @mount="$monter_page()"
    @unmount="await $demonter_page()"
>
    @static
        @if [$authentification = interdite & $connecte]
            navigation
                <div .gauche>
                    fleche-retour

                <div .centre>
                    <span>
                        "Déjà connecté"

                <div .droite>
                    icone-horloge

            onglet
                section-deja-connecte

        @else-if [$authentification = requise & ! $connecte]
            navigation
                <div .gauche>
                    fleche-retour

                <div .centre>
                    <span>
                        "Pas encore conecté"

                <div .droite>
                    icone-horloge

            onglet
                section-pas-encore-connecte

        @else
            @stud

@script [
    $monter_tete = () =>
    {
        $node.classList.add('entree')
        requestAnimationFrame(() => 
            requestAnimationFrame(() => 
                $node.classList.remove('entree')
            )
        )

        obtenir_compte()
    }

    obtenir_compte = async () =>
    {
        const reponse = await $search('moi')
        console.log(reponse)
        if (!reponse.error)
        {
            $compte = reponse.data
        }
    }
]

@style [
    #tete {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        z-index: 50;

        padding: 1rem;


        transition: opacity var(--d-animation), background var(--d-animation);

        --c-fond: var(--c-analogue);
        --l-ecart: 2rem;
    }

    #tete:has(+ #corps > #page > .page.entree),
    #tete:has(+ #corps > #page > .page.sortie) {
        --f-fond: var(--c-analogue);
    }

    #tete.entree {
        opacity: 0;
    }

    .grand #tete {
        width: var(--l-tete);
    }

    .petit.portrait #tete {
        top: auto;
        right: 0;
    }
]

<header
    #tete
    @mount="$monter_tete()"
>
    logo
    menu

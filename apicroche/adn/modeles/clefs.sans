@name [ clefs, clef ]

@primary [ hachage_coordonnee, type, date_emission ]

@fields [
    {
        alt  : coordonnee
        name : hachage_coordonnee
        type : hash

        can_create  : "
            $type = authentification
          & $hachage_coordonnee ~= /^[^@\s]+@[^@\s]+\.[^@\s]+$/
        "
        prior_create : $supprimer_clefs_anciennes($values)
    }

    {
        name : type
        type : authentification/autre
        size : 1-32

        can_create : "
            $type = authentification
        "
    }

    {
        name    : clef
        type    : hash
        size    : 1-256
        chars   : [0-9]
        length  : 9
        default : auto

        prior_create : $envoyer_clef($values)
    }

    {
        name    : date_emission
        type    : datetime
        default : now
    }

    {
        name    : date_validite
        type    : datetime
        default : now+15m
    }
]

@routes [
    {
        path   : /authentification
        action : $authentifier_clef($body)
    }
]

@script [
    $supprimer_clefs_anciennes = async ($values) =>
    {
        const clef_recente = await $search_one('clef',
            `
            $hachage_coordonnee = $values.hachage_coordonnee
          & $type               = $values.type
          & $date_emission      > now-1m
            `,
            { $values }
        )

        if (clef_recente)
            return $indicate(429, "Clef trop récente déjà existante")

        await $delete_all('clefs',
            `
            $hachage_coordonnee = $values.hachage_coordonnee
          & $type = $values.type
            `,
            { $values },
            {
                order  : 'date_emission',
                dir    : 'desc',
                offset : 1
            }
        )
    }

    $envoyer_clef = async ($values) =>
    {
        const clef_affichee = String($values.clef).replace(/(\d{3})(?=\d)/g, '$1 ')

        const coordonnee_existante = await $search_one('coordonnee',
            `
            $hachage_coordonnee = $values.hachage_coordonnee
            `,
            { $values }
        )

        await $send_email({
            to      : $values.hachage_coordonnee,
            subject : coordonnee_existante ? "Votre code de connexion" : "Votre code d'inscription",
            content : `<p>Votre code : <strong>${clef_affichee}</strong></p>`
        })
    }

    $authentifier_clef = async ($body) =>
    {
        if (
            !$body.coordonnee
         || !$body.clef
        )
            return $indicate(400, "Corps incomplet")

        const clef = await $search_one('clef',
            `
            $hachage_coordonnee = $body.coordonnee
          & $type               = authentification
          & $clef               = $body.clef
          & $date_validite      > now
            `
        )

        const coordonnee_existante = await $search_one('coordonnee',
            `
            $hachage_coordonnee = $body.coordonnee
            `
        )

        if (!clef)
            return $indicate(403, 'Accès refusé')

        return $indicate(200, "Authentification réussie", {
            type : coordonnee_existante ? 'connexion' : 'inscription'
        })
    }
]

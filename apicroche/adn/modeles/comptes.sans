@name [ comptes, compte ]

@primary [ id ]

@fields [
    {
        name    : id
        type    : char
        size    : 12
        chars   : [A-Z0-9]
        default : auto
    }

    {
        name  : hachage_mot_de_passe
        type  : hash
        size  : 1-256
        count : 0-1
        rule  : "$hachage_mot_de_passe ~= /^.{12,128}$/"
    }

    {
        name :  date_naissance
        type :  crypt
        size :  1-64
        count : 0-1
    }

    {
        name    : date_inscription
        type    : date
        default : now
    }

    {
        name  : coordonnees
        count : 0-N
    }

    {
        name  : sessions
        count : 0-N
    }
]

@routes [
    {
        path   : /inscription
        action : $inscrire_compte($body)
    }

    {
        path   : /connexion
        action : "$connecter_compte($body, $request)"

        # 1. Lire l'identifiant et le mot de passe depuis le corps de la requête
        # 2. Hacher l'identifiant avec HMAC-SHA256
        # 3. Chercher la coordonnée correspondante en base via ce hash
        # 4. Si introuvable → répondre 401 (message générique, sans précision)
        # 5. Récupérer le compte lié à cette coordonnée
        # 6. Vérifier le mot de passe avec Argon2id
        # 7. Si invalide → répondre 401 (même message générique)
        # 8. Générer un access token JWT
        #      (sub = id du compte, auth_time = maintenant, + claims configurés dans @auth)
        # 9. Générer un refresh token opaque
        # 10. Stocker le refresh token en base (lié au compte, prêt pour la rotation)
        # 11. Poser le refresh token en cookie HttpOnly + Secure + SameSite=Strict
        # 12. Répondre 200 avec l'access token
    }
]

@script [
    $inscrire_compte = async ($body) =>
    {
        if (
            !$body.type_coordonnee
         || !$body.coordonnee
         || !$body.clef
         || !$body.mot_de_passe
         || !Array.isArray($body.ids)
         || !$body.ids.length
        )
            return $indicate(400, "Corps incomplet")

        const clef = await $search_one('clef',
            `
            $id                 -{ $body.ids
          & $hachage_coordonnee  = $body.coordonnee
          & $type                = authentification
          & $clef                = $body.clef
          & $nombre_tentatives   >  0
          & $date_validite       > $now
            `
        )

        const coordonnee_existante = await $search_one('coordonnee',
            `
            $hachage_coordonnee = $body.coordonnee
            `
        )

        if (!clef || coordonnee_existante)
        {
            await $update_all('clefs',
                `
                $id                -{ $body.ids
              & $hachage_coordonnee  = $body.coordonnee
              & $type                = authentification
              & $nombre_tentatives  > 0
                `,
                {
                    nombre_tentatives : 'nombre_tentatives - 1'
                }
            )
            return $indicate(403, 'Accès refusé')
        }

        await $delete_all('clefs',
            `
            $hachage_coordonnee = $body.coordonnee
          & $type               = authentification
            `
        )

        const compte = await $create_one('compte', {
            hachage_mot_de_passe : $body.mot_de_passe
        })

        await $create_one('coordonnee', {
            type               : $body.type_coordonnee,
            coordonnee         : $body.coordonnee,
            hachage_coordonnee : $body.coordonnee,
            est_principale     : true,
            id_compte          : compte.id
        })

        return $indicate(201, "Inscription réussie")
    }

    $connecter_compte = async ($body, $request) =>
    {
        if (
            !$body.coordonnee
         || (
                !$body.mot_de_passe
             && (
                    !$body.clef
                 || !Array.isArray($body.ids)
                 || !$body.ids.length
                )
            )
        )
            return $indicate(400, "Corps incomplet")

        const coordonnee = await $search_one('coordonnee',
            `
            $hachage_coordonnee = $body.coordonnee
            `
        )

        if ($body.mot_de_passe)
        {
            if (!coordonnee)
                return $indicate(403, "Accès refusé")

            const compte = await $search_one('compte',
                `
                $id                   = $coordonnee.id_compte
              & $hachage_mot_de_passe = $body.mot_de_passe
                `,
                {$coordonnee: coordonnee}
            )

            if (!compte)
                return $indicate(403, "Accès refusé")
        }
        else
        {
            const clef = await $search_one('clef',
            `
            $id                 -{ $body.ids
          & $hachage_coordonnee  = $body.coordonnee
          & $type                = authentification
          & $clef                = $body.clef
          & $nombre_tentatives   > 0
          & $date_validite       > $now
            `
            )

            if (!clef || !coordonnee)
            {
                await $update_all('clefs',
                    `
                    $id                -{ $body.ids
                  & $hachage_coordonnee  = $body.coordonnee
                  & $type                = authentification
                  & $nombre_tentatives  > 0
                    `,
                    {
                        nombre_tentatives : 'nombre_tentatives - 1'
                    }
                )
                return $indicate(403, 'Accès refusé')
            }

            await $delete_all('clefs',
                `
                $hachage_coordonnee = $body.coordonnee
              & $type               = authentification
                `
            )
        }

        const session = await $create_one('session',
            {
                adresse_ip        : $request.ip,
                agent_utilisateur : $request.user_agent,
                id_compte         : coordonnee.id_compte
            }
        )

        $set_cookie('jeton', session.jeton, { lifetime: '30d' })

        const jeton_acces = await $sign_token({ id_compte: coordonnee.id_compte })

        return $indicate(200, "Connexion réussie", { jeton_acces })
    }
]

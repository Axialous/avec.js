@actions [
    {
        periodically : $nettoyer_sessions()
        period : 1d
    }

    {
        prior_respond : $rafraichir_jeton()
    }

    {
        post_respond : $detecter_connexion()
    }
]

@routes [
    {
        path    : /test/search/all
        action  : $tester_search_all($body)
        mode    : dev
    }
]

@script [
    $tester_search_all = async ($body) =>
    {
        if (typeof $body !== 'object' || !$body)
            return $indicate(400, 'Corps invalide')

        const name = typeof $body.name === 'string' ? $body.name.trim() : ''
        const projection  = $body.projection
        const restriction = ($body.restriction === undefined || $body.restriction === null)
            ? ':)'
            : (typeof $body.restriction === 'string' ? $body.restriction.trim() : '')

        if (!name)
            return $indicate(400, 'Paramètre requis manquant : name')

        if (!restriction)
            return $indicate(400, 'Le paramètre restriction doit être une chaîne non vide quand il est fourni')

        if (projection !== undefined && projection !== null)
        {
            if (typeof projection !== 'string')
                return $indicate(400, 'Le paramètre projection doit être une chaîne (valeurs séparées par des ; )')
        }

        let resultats
        try
        {
            resultats = (projection === undefined || projection === null)
                ? await $search_all(name, restriction)
                : await $search_all(name, restriction, {}, { select: projection })
        }
        catch (err)
        {
            const message = typeof err?.message === 'string' && err.message
                ? err.message
                : 'Erreur search_all'
            return $indicate(422, message)
        }

        return $indicate(200, 'Recherche effectuée', {
            total    : resultats.length,
            resultats: resultats
        })
    }

    $nettoyer_sessions = async () =>
    {
        console.log('=================\nNETTOYER SESSIONS\n=================')
        await $delete_all('sessions',
            `
            $date_revocation != null
          | $date_validite   < now
            `
        )
    }

    $rafraichir_jeton = async () =>
    {
        const en_tete = $request.headers?.authorization ?? null
        const jeton_acces = en_tete?.startsWith('Bearer ')
            ? en_tete.slice(7).trim()
            : null

        if (jeton_acces)
        {
            const payload = await $verify_token(jeton_acces)

            if (payload?.id_compte)
            {
                const compte = await $search_one('compte',
                    `$id = $payload.id_compte`,
                    { $payload: payload }
                )

                if (compte)
                {
                    $context.compte = compte
                    return
                }
            }
        }

        const cookie_session = $request.cookies?.jeton ?? null

        if (!cookie_session)
            return

        const separateur = cookie_session.indexOf('.')
        if (separateur <= 0 || separateur >= cookie_session.length - 1)
            return

        const id_session = cookie_session.slice(0, separateur)
        const jeton_session = cookie_session.slice(separateur + 1)

        const session = await $search_one('session',
            `
            $id              = $id_session
          & $hachage_jeton   = $jeton_session
          & $date_validite   > now
          & $date_revocation = null
            `,
            {
                $id_session: id_session,
                $jeton_session: jeton_session
            }
        )

        if (!session)
            return

        const maintenant = new Date()
        const emission = new Date(session.date_emission)
        const validite = new Date(session.date_validite)
        const duree_totale = validite - emission
        const duree_restante = validite - maintenant

        if (duree_restante < duree_totale / 2)
        {
            await $update_one('session',
                `$id = $session.id`,
                { date_revocation: 'now' },
                { $session: session }
            )

            const nouvelle_session = await $create_one('session', {
                id_compte         : session.id_compte,
                adresse_ip        : $request.ip,
                agent_utilisateur : $request.user_agent
            })

            const cookie_rotation = `${nouvelle_session.id}.${nouvelle_session.jeton}`
            $set_cookie('jeton', cookie_rotation, { lifetime: '30d' })

            const nouveau_jeton_acces = await $sign_token({ id_compte: session.id_compte })
            $add_to_data('jeton_acces', nouveau_jeton_acces)
        }

        const compte = await $search_one('compte',
            `$id = $session.id_compte`,
            { $session: session }
        )

        $context.compte = compte
    }

    $detecter_connexion = async () =>
    {
        $add_to_data('est_connecte', !!$context.compte)
    }

    $exiger_compte = () =>
    {
        if (!$context.compte)
            return $indicate(401, 'Non authentifié')
    }
]

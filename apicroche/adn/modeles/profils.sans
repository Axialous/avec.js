@name [ profils, profil ]

@primary [ id ]

@unique [
    [ identifiant ]
]

@fields [
    {
        name    : id
        type    : char
        size    : 15
        chars   : [A-Z0-9]
        default : auto
    }

    {
        name : identifiant
        type : char
        size : 1-65
        rule : "$identifiant ~= /^(?=.{1,32}(?:\.|$))(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*(?:\.(?=.{1,32}$)(?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)*)?$/"

        can_create   : ':)'
        prior_create : $valider_creation_profil($values)
        post_create  : $lier_createur_au_profil($values)
    }

    {
        name : pseudonyme
        type : char
        size : 1-64

        can_create : ':)'
    }

    {
        name    : date_creation
        type    : date
        default : now
    }

    {
        name  : gerants
        entry : gerant
        ref   : comptes
        count : N-N
    }
]

@script [
    $valider_creation_profil = async ($values) =>
    {
        await $exiger_compte()

        if (!$values.identifiant || !$values.pseudonyme)
            return $indicate(400, "Corps incomplet")

        const profil_existant = await $search_one('profil',
            `#identifiant = $values.identifiant`,
            { $values }
        )

        if (profil_existant)
            return $indicate(409, "Identifiant déjà utilisé")

        const separateur = $values.identifiant.indexOf('.')

        if (separateur <= 0)
        {
            const profils_geres_racines = await $search_all('profils',
                `#gerants.id = $id_compte`,
                { $id_compte: $context.compte.id },
                { select: 'identifiant' }
            )

            const nombre_profils_sans_point = profils_geres_racines
                .filter(profil => !(profil.identifiant ?? '').includes('.'))
                .length

            if (nombre_profils_sans_point >= 5)
                return $indicate(403, "Limite de profils racines atteinte")
        }
        else
        {
            const identifiant_parent = $values.identifiant.slice(0, separateur)

            const parent = await $search_one('profil',
                `#identifiant = $identifiant_parent`,
                { $identifiant_parent: identifiant_parent }
            )

            if (!parent)
                return $indicate(422, "Profil racine introuvable")

            const est_gerant = await $search_one('gerant_profil',
                `
                #id_compte = $id_compte
              & #id_profil = $id_profil
                `,
                {
                    $id_compte: $context.compte.id,
                    $id_profil: parent.id
                }
            )

            if (!est_gerant)
                return $indicate(403, "Profil racine inaccessible")
        }
    }

    $lier_createur_au_profil = async ($values) =>
    {
        await $create_one('gerant_profil', {
            id_compte: $context.compte.id,
            id_profil: $values.id
        })
    }
]
